// Bityo Delta — Prisma schema (Supabase PostgreSQL)
// DATABASE_URL  = Transaction pooler (port 6543, pgbouncer) — runtime queries
// DIRECT_URL    = Session pooler (port 5432) — `prisma db push` / migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Identity is owned by Supabase Auth (auth.users). We keep no User/Session tables of our
// own; preferences live in the user's Supabase user_metadata. ExchangeAccount.userId holds
// the Supabase auth UID (uuid as text) — not an FK, since auth.users lives in another schema.

// One connected exchange API key per row. Secret + passphrase are AES-256-GCM encrypted.
model ExchangeAccount {
  id           String   @id @default(cuid())
  userId       String // Supabase auth user id
  exchange     String // 'binance' | 'bybit' | 'okx' | 'bingx' | 'bitget' | 'bitunix' | 'pionex'
  label        String? // optional user label
  apiKey       String // encrypted
  apiSecret    String // encrypted
  passphrase   String? // encrypted (OKX / Bitget / Bitunix require it)
  enabled      Boolean  @default(true)
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime @default(now())

  @@unique([userId, exchange, apiKey])
  @@index([userId])
}
